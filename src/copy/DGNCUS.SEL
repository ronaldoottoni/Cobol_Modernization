           SELECT DGNCUS ASSIGN    TO WS-DGNCUS
                  ORGANIZATION     IS INDEXED
                  ACCESS MODE      IS DYNAMIC
                  LOCK MODE        IS MANUAL
                  WITH LOCK        ON RECORD
                  RECORD KEY       IS DGNCUS-KEY
                  ALTERNATE 
                  RECORD KEY       IS DGNCUS-KEY-2 =
                                      DGNCUS-DOCUMENT
                                      DGNCUS-KEY
                  WITH             DUPLICATES
                  FILE STATUS      IS WS-STATUS.
